{
	"semi": true,
	"singleQuote": false,
	"useTabs": true,
	"printWidth": 120,
	"trailingComma": "es5",
	"arrowParens": "avoid",
	"endOfLine": "auto",
	"proseWrap": "never",
	"plugins": ["prettier-plugin-organize-attributes", "prettier-plugin-tailwindcss"],
	"attributeGroups": [
		"^v-(if|else-if|else|show|cloak|for)$",
		"^id$",
		"^ref$",
		"^key$",
		"^aria-",
		"$DEFAULT",
		"^v-model",
		"^v-bind",
		"^:",
		"^class$",
		"^style$",
		"^@",
		"^v-on"
	],
	"tailwindStylesheet": "./src/assets/css/index.css"
}
