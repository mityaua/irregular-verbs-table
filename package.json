{
	"name": "irregular-verbs-table",
	"private": true,
	"version": "1.6.0",
	"type": "module",
	"scripts": {
		"dev": "vite --open",
		"build": "vue-tsc && vite build",
		"preview": "vite preview",
		"host": "vite --host",
		"format": "oxfmt --write src/",
		"format:check": "oxfmt --check src/",
		"lint": "oxlint",
		"type-check": "vue-tsc --noEmit -p tsconfig.json --composite false"
	},
	"dependencies": {
		"vue": "3.5.43",
		"vue-gtag": "3.7.1"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "26.6.4",
		"@vitejs/plugin-vue": "6.0.9",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.2",
		"vite-plugin-mkcert": "2.1.0",
		"vite-svg-loader": "5.1.3",
		"vue-tsc": "3.3.12"
	}
}
